# ScoutD3 Environment Configuration

# Application Settings
APP_NAME=ScoutD3
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database Configuration
# Use PostgreSQL in deployed environments. The code also tolerates sqlite URLs for local fallback/testing.
DATABASE_URL=postgresql://scoutd3:scoutd3@localhost:5432/scoutd3
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=change-this-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Data Ingestion Settings
DEFAULT_RATE_LIMIT=1.0
MAX_CONCURRENT_JOBS=3
DATA_REFRESH_INTERVAL_HOURS=6
MAX_GAMES_PER_ANALYSIS=50

# Report Generation
REPORT_CACHE_DURATION_HOURS=24
WCAG_COMPLIANCE_LEVEL=AA
ANONYMOUS_PLAYER_PREFIX=P
PDF_GENERATION_ENGINE=weasyprint

# External Services (Optional)
SENTRY_DSN=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# File Storage
STATIC_FILES_DIR=static
REPORTS_OUTPUT_DIR=reports
TEMP_FILES_DIR=tmp

# Analytics Settings
ENABLE_PREDICTIVE_MODELING=true
MIN_GAMES_FOR_ANALYSIS=5
TREND_ANALYSIS_WINDOW=10

# Accessibility Features
ENABLE_SCREEN_READER_SUPPORT=true
ENABLE_HIGH_CONTRAST_MODE=true
ENABLE_KEYBOARD_NAVIGATION=true
FONT_SIZE_SCALING=true

# Monitoring and Logging
ENABLE_PERFORMANCE_MONITORING=true
LOG_SQL_QUERIES=false
ENABLE_API_METRICS=true