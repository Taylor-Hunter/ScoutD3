# ScoutD3 production environment template
# Copy to .env.prod before deploying the VPS stack.

POSTGRES_DB=scoutd3
POSTGRES_USER=scoutd3
POSTGRES_PASSWORD=replace_with_a_strong_database_password

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Public domain configuration for same-origin production traffic.
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
VITE_API_URL=/api/v1

# Background refresh cadence in hours.
DATA_REFRESH_INTERVAL_HOURS=6